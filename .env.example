# Copy to .env.local and fill in real values

# Supabase / PostgreSQL — pooled connection (app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Supabase / PostgreSQL — direct connection (Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# NextAuth base URL
NEXTAUTH_URL="http://localhost:3000"

# Receipt storage: "database" stores receipts as blobs in Postgres
# Set to "vercel_blob" and provide BLOB_READ_WRITE_TOKEN to use Vercel Blob instead
RECEIPT_STORAGE="database"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
