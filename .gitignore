# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code local tooling (CLAUDE.md and AGENTS.md are intentionally tracked)
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets — never commit)
.env*
!.env.example

# Google service-account keys (secrets — never commit)
treasurer-app-*.json
*-service-account*.json
gcp-*.json

# misc local clutter
.playwright-mcp/
.Rhistory

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local design-review screenshots
screenshots/
