# Env vars to set on the Vercel DEMO project (Production).
# NOTE: intentionally NO GOOGLE_* vars — the demo stubs Google Sheets.

DEMO_MODE=1
NEXT_PUBLIC_DEMO_MODE=1

# Neon Postgres (from the Vercel <-> Neon integration)
DATABASE_URL=postgres://...
DIRECT_URL=postgres://...

# NextAuth
AUTH_SECRET=<generate: openssl rand -base64 32>
NEXTAUTH_URL=https://<your-demo>.vercel.app

# Reset endpoint
CRON_SECRET=<generate: openssl rand -base64 32>        # used by Vercel Cron
DEMO_RESET_SECRET=<generate: openssl rand -base64 32>  # for manual resets

# Receipts (auto-added when you attach Vercel Blob storage)
BLOB_READ_WRITE_TOKEN=<auto>
