generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  Role
  avatarUrl             String?
  departmentId          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  activityLogs          ActivityLog[]
  reviewedRequests      ReimbursementRequest[] @relation("ReviewedBy")
  submittedRequests     ReimbursementRequest[] @relation("SubmittedBy")
  submittedTransactions Transaction[]
  department            Department?            @relation(fields: [departmentId], references: [id])
}

model Department {
  id             String                 @id @default(cuid())
  name           String
  description    String?
  icon           String?
  colorHex       String
  createdAt      DateTime               @default(now())
  budgets        Budget[]
  requests       ReimbursementRequest[]
  officers       User[]
  signupRequests SignupRequest[]
}

model SignupRequest {
  id           String        @id @default(cuid())
  name         String
  email        String
  passwordHash String
  departmentId String?
  role         Role          @default(officer)
  status       RequestStatus @default(pending)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  department   Department?   @relation(fields: [departmentId], references: [id])
}

model Budget {
  id           String        @id @default(cuid())
  departmentId String
  name         String
  year         Int
  semester     Semester      @default(fall)
  totalAmount  Decimal       @db.Decimal(12, 2)
  status       BudgetStatus  @default(active)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  department   Department    @relation(fields: [departmentId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id            String            @id @default(cuid())
  budgetId      String
  vendor        String
  category      String
  amount        Decimal           @db.Decimal(12, 2)
  date          DateTime
  status        TransactionStatus @default(pending)
  submittedById String
  receiptUrl    String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  budget        Budget            @relation(fields: [budgetId], references: [id])
  submittedBy   User              @relation(fields: [submittedById], references: [id])
}

model ReimbursementRequest {
  id            String        @id @default(cuid())
  submittedById String
  departmentId  String
  amount        Decimal       @db.Decimal(12, 2)
  category      String
  paymentMethod String        @default("card")
  venmoZelle    String?
  project       String?
  description   String
  status        RequestStatus @default(pending)
  internalNote  String?
  reviewedById  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  receipts      Receipt[]
  department    Department    @relation(fields: [departmentId], references: [id])
  reviewedBy    User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  submittedBy   User          @relation("SubmittedBy", fields: [submittedById], references: [id])
}

model Receipt {
  id        String               @id @default(cuid())
  requestId String
  filename  String
  url       String
  mimeType  String
  createdAt DateTime             @default(now())
  request   ReimbursementRequest @relation(fields: [requestId], references: [id])
}

model Member {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  phone       String?
  tier        String
  duesStatus  DuesStatus @default(overdue)
  lastPayment DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ActivityLog {
  id              String   @id @default(cuid())
  userId          String
  action          String
  ipAddress       String?
  sessionDuration Int?
  timestamp       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

enum Role {
  officer
  executive
  admin
}

enum RequestStatus {
  pending
  approved
  denied
}

enum TransactionStatus {
  pending
  approved
  denied
}

enum BudgetStatus {
  draft
  active
  closed
}

enum DuesStatus {
  paid
  overdue
  exempt
}

enum Semester {
  spring
  fall
}

enum IncomeType {
  dues
  rental
  other
}

model Income {
  id          String     @id @default(cuid())
  type        IncomeType
  amount      Decimal    @db.Decimal(12, 2)
  description String
  date        DateTime
  semester    Semester
  year        Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
