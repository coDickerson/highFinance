generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  Role
  avatarUrl             String?
  departmentId          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  activityLogs          ActivityLog[]
  reviewedRequests      ReimbursementRequest[] @relation("ReviewedBy")
  submittedRequests     ReimbursementRequest[] @relation("SubmittedBy")
  submittedTransactions Transaction[]
  department            Department?            @relation(fields: [departmentId], references: [id])
  userDepartments       UserDepartment[]
}

model UserDepartment {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model Department {
  id              String                 @id @default(cuid())
  name            String
  description     String?
  icon            String?
  colorHex        String
  createdAt       DateTime               @default(now())
  budgets         Budget[]
  requests        ReimbursementRequest[]
  officers        User[]
  signupRequests  SignupRequest[]
  userDepartments UserDepartment[]
}

model SignupRequest {
  id           String        @id @default(cuid())
  name         String
  email        String
  passwordHash String
  departmentId String?
  role         Role          @default(officer)
  status       RequestStatus @default(pending)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  department   Department?   @relation(fields: [departmentId], references: [id])
}

model Budget {
  id           String        @id @default(cuid())
  departmentId String
  name         String
  year         Int
  semester     Semester      @default(fall)
  totalAmount  Decimal       @db.Decimal(12, 2)
  status       BudgetStatus  @default(active)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  department   Department    @relation(fields: [departmentId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id            String            @id @default(cuid())
  budgetId      String
  vendor        String
  category      String            @default("")
  amount        Decimal           @db.Decimal(12, 2)
  date          DateTime
  status        TransactionStatus @default(pending)
  submittedById String
  receiptUrl    String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  budget        Budget            @relation(fields: [budgetId], references: [id])
  submittedBy   User              @relation(fields: [submittedById], references: [id])
}

model ReimbursementRequest {
  id            String        @id @default(cuid())
  submittedById String
  departmentId  String
  amount        Decimal       @db.Decimal(12, 2)
  category      String
  paymentMethod String        @default("card")
  venmoZelle    String?
  project       String?
  description   String
  status        RequestStatus @default(pending)
  internalNote  String?
  reviewedById  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  receipts      Receipt[]
  department    Department    @relation(fields: [departmentId], references: [id])
  reviewedBy    User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  submittedBy   User          @relation("SubmittedBy", fields: [submittedById], references: [id])
}

model Receipt {
  id        String               @id @default(cuid())
  requestId String
  filename  String
  url       String
  mimeType  String
  createdAt DateTime             @default(now())
  request   ReimbursementRequest @relation(fields: [requestId], references: [id])
}

model Member {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  phone       String?
  tier        String
  duesStatus  DuesStatus @default(overdue)
  lastPayment DateTime?
  duesOwed    Decimal    @default(0) @db.Decimal(12, 2)
  duesPaid    Decimal    @default(0) @db.Decimal(12, 2)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ActivityLog {
  id              String   @id @default(cuid())
  userId          String
  action          String
  ipAddress       String?
  sessionDuration Int?
  timestamp       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

enum Role {
  officer
  executive
  admin
}

enum RequestStatus {
  pending
  approved
  denied
}

enum TransactionStatus {
  pending
  approved
  denied
}

enum BudgetStatus {
  draft
  active
  closed
}

enum DuesStatus {
  paid
  in_progress
  overdue
  exempt
}

enum Semester {
  spring
  fall
}

enum IncomeType {
  dues
  rental
  other
}

model Income {
  id          String     @id @default(cuid())
  type        IncomeType
  amount      Decimal    @db.Decimal(12, 2)
  description String
  date        DateTime
  semester    Semester
  year        Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model FeeBudget {
  id         String        @id @default(cuid())
  semester   Semester
  year       Int
  createdAt  DateTime      @default(now())
  categories FeeCategory[]
}

model FeeCategory {
  id          String    @id @default(cuid())
  feeBudgetId String
  name        String
  sortOrder   Int       @default(0)
  feeBudget   FeeBudget @relation(fields: [feeBudgetId], references: [id], onDelete: Cascade)
  items       FeeItem[]
}

model FeeItem {
  id             String      @id @default(cuid())
  feeCategoryId  String
  description    String
  perMember      Decimal?    @db.Decimal(10, 2)
  estimatedTotal Decimal     @db.Decimal(12, 2)
  actualTotal    Decimal?    @db.Decimal(12, 2)
  dueDate        String?
  paidDate       String?
  notes          String?
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  feeCategory    FeeCategory @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
}
